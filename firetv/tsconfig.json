{
    "extends": "@react-native/typescript-config",
    "compilerOptions": {
        "types": ["jest", "@amazon-devices/react-native-kepler"], // Override "jest", "react-native" from @react-native/typescript-config
    },
    // Android-only files are checked by the Fire OS build (fireos/), which has their packages
    "exclude": ["node_modules", "fireos", "src/**/*.android.ts", "src/**/*.android.tsx"],
}
